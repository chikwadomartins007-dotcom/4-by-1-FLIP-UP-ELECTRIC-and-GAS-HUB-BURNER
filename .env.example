# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# META CONVERSIONS API (Server-Side Tracking)
# Set your Meta Pixel ID (defaults to 1730802201545460)
META_PIXEL_ID="1730802201545460"

# Meta System User Access Token from Facebook Business Manager (Events Manager -> Settings -> Generate Access Token)
# CRITICAL: Keep this server-side only. Never expose to client-side code.
META_ACCESS_TOKEN=""

# Optional Meta Test Event Code (e.g. TEST12345) for testing server-side Conversions API in Meta Events Manager
META_TEST_EVENT_CODE=""
